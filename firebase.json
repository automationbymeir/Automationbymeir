{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "schedule"
      },
      {
        "source": "/he",
        "destination": "/he/index.html"
      }
    ]
  }
}
